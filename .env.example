# Copy to .env and fill in values:  cp .env.example .env
# Every variable read by backend/app/config.py is documented here.

# ── Environment ────────────────────────────────────────────────────────────────
# development | production  (production disables /docs and enforces secure cookies)
ENVIRONMENT=development
# fake = deterministic scripted LLMs + fixture retrievers (no API keys needed; used by tests/CI)
# real = call the configured providers below
LLM_MODE=real

# ── LLM providers (BYOK — only providers you route models to are required) ─────
# Get a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Model routing (provider:model — see docs/04_Agent_Design.md §7) ────────────
# Default (Google Gemini):
# MODEL_PLANNER=google:gemini-2.5-pro
# MODEL_EXECUTOR=google:gemini-2.5-flash
# MODEL_CRITIC=google:gemini-2.5-flash
# MODEL_SYNTHESIZER=google:gemini-2.5-pro
# MODEL_CHAT=google:gemini-2.5-flash
# Anthropic (set ANTHROPIC_API_KEY above): Opus 4.8 for reasoning, Haiku 4.5 for volume.
# MODEL_PLANNER=anthropic:claude-opus-4-8
# MODEL_EXECUTOR=anthropic:claude-haiku-4-5
# MODEL_CRITIC=anthropic:claude-haiku-4-5
# MODEL_SYNTHESIZER=anthropic:claude-opus-4-8
# MODEL_CHAT=anthropic:claude-haiku-4-5

# ── Search retrievers (optional; chain falls back Tavily → Brave → DuckDuckGo) ─
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Data stores ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://research_user:research_pass@localhost:5432/research_db
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED: >= 32 chars of real randomness. Generate with:  openssl rand -hex 32
# Startup refuses placeholder or short values.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Encrypts users' own (BYOK) provider keys at rest. Defaults to deriving from
# JWT_SECRET_KEY; set explicitly in production so rotating JWTs doesn't
# invalidate stored keys.  Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Require email verification before login (recommended ON for public deployments)
REQUIRE_EMAIL_VERIFICATION=false

# ── Agent budgets (see docs/04_Agent_Design.md §6) ─────────────────────────────
# Token ceiling applied to every NEW account (0 = unlimited). Set this on public
# deployments so one signup can't drain a shared server key; users can raise their
# own ceiling by adding a personal API key in Settings.
DEFAULT_MONTHLY_TOKEN_LIMIT=0

MAX_CRITIC_LOOPS=2
MAX_COST_PER_SESSION_USD=0.50
MAX_WALLCLOCK_SECONDS=600
CELERY_TASK_TIMEOUT_SECONDS=660

# How many research tasks run at once. Higher = faster runs, more concurrent provider
# calls (watch your rate limits). 1 = strictly sequential, and the only setting where
# a run can never overshoot MAX_COST_PER_SESSION_USD: with N workers, up to N calls can
# already be in flight when the cap is crossed. See docs/12 M7.
MAX_PARALLEL_TASKS=4

# ── Optional: LangSmith tracing ────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=multi-agent-research-assistant

# ── Frontend origin (dev only; prod uses the same-origin proxy) ────────────────
FRONTEND_URL=http://localhost:3000
