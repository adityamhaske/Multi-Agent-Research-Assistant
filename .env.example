# Copy to .env and fill in values:  cp .env.example .env
# Every variable read by backend/app/config.py is documented here.

# ── Environment ────────────────────────────────────────────────────────────────
# development | production  (production disables /docs and enforces secure cookies)
ENVIRONMENT=development
# fake = deterministic scripted LLMs + fixture retrievers (no API keys needed; used by tests/CI)
# real = call the configured providers below
LLM_MODE=real

# ── LLM providers (BYOK — only providers you route models to are required) ─────
# Get a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# One key, many upstream models. NOTE: the price catalog cannot price OpenRouter or a
# custom endpoint, so MAX_COST_PER_SESSION_USD never fires on them — cap at the provider.
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint. Both are needed together.
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=

# ── Model routing (provider:model — see docs/architecture/04-agent-architecture.md) ──
# Default (Google Gemini):
# MODEL_PLANNER=google:gemini-2.5-pro
# MODEL_EXECUTOR=google:gemini-2.5-flash
# MODEL_CRITIC=google:gemini-2.5-flash
# MODEL_SYNTHESIZER=google:gemini-2.5-pro
# MODEL_CHAT=google:gemini-2.5-flash
# Anthropic (set ANTHROPIC_API_KEY above): Opus 4.8 for reasoning, Haiku 4.5 for volume.
# MODEL_PLANNER=anthropic:claude-opus-4-8
# MODEL_EXECUTOR=anthropic:claude-haiku-4-5
# MODEL_CRITIC=anthropic:claude-haiku-4-5
# MODEL_SYNTHESIZER=anthropic:claude-opus-4-8
# MODEL_CHAT=anthropic:claude-haiku-4-5
# Local Ollama (no key, no cost — `ollama pull qwen2.5:14b` first). Route to the EXACT
# installed tag: naming the family alone resolves to `:latest`, which is a different
# model from the one you pulled. Small models are weaker at the structured/tool-calling
# steps; 14B is the working floor for research, and anything runs chat.
# MODEL_PLANNER=ollama:qwen2.5:14b
# MODEL_EXECUTOR=ollama:qwen2.5:14b
# MODEL_CRITIC=ollama:qwen2.5:14b
# MODEL_SYNTHESIZER=ollama:qwen2.5:14b
# MODEL_CHAT=ollama:qwen2.5:14b

# ── Local LLM (Ollama) ──────────────────────────────────────────────────────────
# OpenAI-compatible endpoint of the Ollama server. In Docker, reach the host with
# host.docker.internal; a native/desktop run can use localhost.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ── Search retrievers (optional; chain falls back Tavily → Brave → DuckDuckGo) ─
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Data stores ────────────────────────────────────────────────────────────────
# Postgres must be a pgvector image — migration 0006 enables the extension and 0007
# creates a vector column, so stock Postgres fails `alembic upgrade head` outright.
DATABASE_URL=postgresql+asyncpg://research_user:research_pass@localhost:5432/research_db
REDIS_URL=redis://localhost:6379/0
# Where per-project corpus SQLite files live. A relative path resolves against the backend
# package root, not the process working directory — otherwise running from the repo root
# and from backend/ would create two different corpus roots.
# CORPUS_DIR=data/corpus

# ── Project memory / corpus embeddings ─────────────────────────────────────────
# auto | ollama | google | openai | none.  "auto" prefers a reachable local Ollama (free,
# no egress) and falls back to whichever hosted provider has a key. "none" disables
# memory and project chat rather than degrading them.
# EMBEDDINGS_PROVIDER=auto
# Blank = the provider's documented default. Changing this makes existing chunks invisible
# until they are re-indexed: vectors from different models are not comparable even at equal
# width, so retrieval filters on the model that produced them.
# EMBEDDINGS_MODEL=

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED: >= 32 chars of real randomness. Generate with:  openssl rand -hex 32
# Startup refuses placeholder or short values.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Encrypts users' own (BYOK) provider keys at rest. Defaults to deriving from
# JWT_SECRET_KEY; set explicitly in production so rotating JWTs doesn't
# invalidate stored keys.  Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Require email verification before login (recommended ON for public deployments)
REQUIRE_EMAIL_VERIFICATION=false

# ── Agent budgets (see docs/reference/36-configuration.md) ────────────────────
# Token ceiling applied to every NEW account (0 = unlimited). Set this on public
# deployments so one signup can't drain a shared server key; users can raise their
# own ceiling by adding a personal API key in Settings.
DEFAULT_MONTHLY_TOKEN_LIMIT=0

# Run limits — each of these is 0 = unlimited, and 0 is the default.
# Nothing stops a long run out of the box. Set them when you want a hard stop.
#
# Note MAX_COST_PER_SESSION_USD cannot protect you on openrouter or custom endpoints:
# their prices are not in the catalog, so estimated cost is always 0.00 and the cap never
# fires. On those providers cap spend at the provider's own dashboard. The token ceiling
# is the guard that works everywhere, because it counts what the models were actually sent.
MAX_CRITIC_LOOPS=2
MAX_COST_PER_SESSION_USD=0
MAX_WALLCLOCK_SECONDS=0
# Cumulative input tokens for one session, including critic loops and rework.
MAX_INPUT_TOKENS=0
CELERY_TASK_TIMEOUT_SECONDS=660

# How many research tasks run at once. Higher = faster runs, more concurrent provider
# calls (watch your rate limits). 1 = strictly sequential, and the only setting where
# a run can never overshoot MAX_COST_PER_SESSION_USD: with N workers, up to N calls can
# already be in flight when the cap is crossed.
MAX_PARALLEL_TASKS=4

# ── Per-user abuse guards (multi-tenant deployments) ───────────────────────────
# Both are 0 = unlimited, and 0 is the default: this ships as a single-tenant self-hosted
# app where the operator is the only user and pays their own provider bill, so throttling
# them protects nobody. SET BOTH on any public deployment. Enforced before model routing
# is consulted. Login and registration limits are separate, are brute-force protection
# rather than usage caps, and are deliberately NOT configurable.
RESEARCH_RATE_LIMIT_PER_HOUR=0
CHAT_RATE_LIMIT_PER_HOUR=0

# ── Optional: LangSmith tracing ────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=multi-agent-research-assistant

# ── Frontend origin (dev only; prod uses the same-origin proxy) ────────────────
FRONTEND_URL=http://localhost:3031
