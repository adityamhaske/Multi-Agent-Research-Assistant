# Per-developer coding-agent state. Plans are working notes, not a build contract, and a
# completed one left in the tree reads as a description of the product; the shipped design
# belongs in `docs/`, which is where the code cites it from.
.claude/settings.local.json
.claude/plans/

# Scratch space for positioning notes, drafts, and ideas that are not yet decisions.
future-plans/

# Editor/agent tool directories. Per-tool config, not project code.
.qoder/
.codex/


# Personal presentation/interview notes. Kept beside the code so it is easy to open during a
# walkthrough, but it is a personal artifact rather than project documentation — the shipped
# explanation of how this works is README.md and docs/, and a second one in the tree would
# drift from them silently.
/PRESENTATION.md
